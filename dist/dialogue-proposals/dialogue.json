      "at": 3280,
      "enemies": [
        "turret"
      ],
      "mode": "radio",
      "lines": [
        {
          "actor": "turret",
          "text": "四向火控就緒。散射封鎖開始。",
          "action": ""
        },
        {
          "actor": "pilot",
          "text": "彈幕會向外展開。先找空隙，別等它合上才動。",
          "action": ""
        }
      ],
      "choices": [
        {
          "label": "觀察砲臂",
          "lines": [
            {
              "actor": "pilot",
              "text": "四支砲臂，不會只有一條射線。",
              "action": ""
            },
            {
              "actor": "turret",
              "text": "擴散序列維持。",
              "action": ""
            }
          ]
        },
        {
          "label": "觀察彈幕",
          "lines": [
            {
              "actor": "pilot",
              "text": "先確認散開的方向，再穿過空隙。",
              "action": ""
            },
            {
              "actor": "turret",
              "text": "追蹤偏差修正。",
              "action": ""
            }
          ]
        }
      ]
    },
    {
      "id": "legacy",
      "title": "12 雙獸壓境",
      "at": 5280,
      "enemies": [
        "legacy-a",
        "legacy-b"
      ],
      "mode": "pause",
      "lines": [
        {
          "actor": "legacy-a",
          "text": "吼——！",
          "action": "正面抬頭，喉部紫光增強。"
        },
        {
          "actor": "pilot",
          "text": "不是剛才那隻……還有第二個熱源！",
          "action": ""
        },
        {
          "actor": "legacy-b",
          "text": "嗚……吼！",
          "action": "從側翼逼近，與前方個體拉開位置。"
        },
        {
          "actor": "pilot",
          "text": "一隻壓住正面，一隻繞到側邊。牠們在配合。",
          "action": ""
        },
        {
          "actor": "legacy-a",
          "text": "嘎——吼！",
          "action": "頭部轉向，沿前方展開掃射姿態。"
        },
        {
          "actor": "pilot",
          "text": "別被夾住。留意兩隻的頭部，先保留能穿出的方向。",
          "action": ""
        }
      ],
      "choices": [
        {
          "label": "警戒正面掃射",
          "lines": [
            {
              "actor": "pilot",
              "text": "正面那隻開始轉頭。先看清掃射方向。",
              "action": ""
            },
            {
              "actor": "legacy-a",
              "text": "吼——！",
              "action": "頸部繼續轉動。"
            },
            {
              "actor": "pilot",
              "text": "也不能忘了側翼那一隻。",
              "action": ""
            }
          ]
        },
        {
          "label": "確認側翼位置",
          "lines": [
            {
              "actor": "pilot",
              "text": "側面那隻還在移動……別往牠的方向退。",
              "action": ""
            },
            {
              "actor": "legacy-b",
              "text": "嗚——！",
              "action": "壓低頭部，維持側向壓力。"
            },
            {
              "actor": "pilot",
              "text": "先留出能離開夾角的路線。",
              "action": ""
            }
          ]
        }
      ]
    }
