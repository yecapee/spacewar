  "encounters": [
    {
      "id": "patrol",
      "title": "01 初航巡邏",
      "at": 0,
      "enemies": [
        "zark-zero"
      ],
      "mode": "radio",
      "lines": [
        {
          "actor": "zark-zero",
          "text": "未登錄機，這裡是封鎖空域。立刻掉頭。",
          "action": ""
        },
        {
          "actor": "pilot",
          "text": "通訊還能接通……你們為什麼封鎖撤離航道？",
          "action": ""
        },
        {
          "actor": "zark-zero",
          "text": "命令不是給你討論的。攔截！",
          "action": ""
        },
        {
          "actor": "pilot",
          "text": "那就先穿過你的火線。",
          "action": ""
        }
      ],
      "choices": [
        {
          "label": "追問封鎖原因",
          "lines": [
            {
              "actor": "pilot",
              "text": "封鎖線後面還有平民。你知道嗎？",
              "action": ""
            },
            {
              "actor": "zark-zero",
              "text": "……保持航向，別逼我開火。",
              "action": ""
            }
          ]
        },
        {
          "label": "直接突破",
          "lines": [
            {
              "actor": "pilot",
              "text": "我不會在這裡停下。",
              "action": ""
            },
            {
              "actor": "zark-zero",
              "text": "全隊，攔住那架白色機！",
              "action": ""
            }
          ]
        }
      ]
    },
    {
      "id": "fort",
      "title": "02 交叉火網",
      "at": 640,
      "enemies": [
        "fort"
      ],
      "mode": "radio",
      "lines": [
        {
          "actor": "fort",
          "text": "識別失敗。追蹤解算完成。",
          "action": ""
        },
        {
          "actor": "pilot",
          "text": "砲口在跟著我轉……不能只往同一邊躲。",
          "action": ""
        }
      ],
      "choices": [
        {
          "label": "觀察鎖定",
          "lines": [
            {
              "actor": "pilot",
              "text": "先看清它什麼時候修正彈道。",
              "action": ""
            },
            {
              "actor": "fort",
              "text": "目標機動資料更新。",
              "action": ""
            }
          ]
        },
        {
          "label": "切換路線",
          "lines": [
            {
              "actor": "pilot",
              "text": "拉開距離，再從另一側切入。",
              "action": ""
            },
            {
              "actor": "fort",
              "text": "重算攔截位置。",
              "action": ""
            }
          ]
        }
      ]
    },
    {
      "id": "plus",
      "title": "02 高速截擊",
      "at": 1040,
      "enemies": [
        "zark-plus"
      ],
      "mode": "radio",
      "lines": [
        {
          "actor": "zark-plus",
          "text": "巡邏隊讓開。白色機，你的轉向我看見了。",
          "action": ""
        },
        {
          "actor": "pilot",
          "text": "速度比剛才快。留好退路，別被她逼到邊緣。",
          "action": ""
        }
      ],
      "choices": [
        {
          "label": "試探對手",
          "lines": [
            {
              "actor": "pilot",
              "text": "看見一次，不代表下一次也一樣。",
              "action": ""
            },
            {
              "actor": "zark-plus",
              "text": "那就讓我看看。",
              "action": ""
            }
          ]
        },
        {
          "label": "保持沉默",
          "lines": [
            {
              "actor": "pilot",
              "text": "……先把她的節奏記住。",
              "action": ""
            },
            {
              "actor": "zark-plus",
              "text": "不回話？好，讓機動替你回答。",
              "action": ""
            }
          ]
        }
      ]
    },
    {
