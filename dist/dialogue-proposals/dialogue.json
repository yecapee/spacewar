      "choices": [
        {
          "label": "觀察左環",
          "lines": [
            {
              "actor": "pilot",
              "text": "左環轉向了，先確認它的追蹤節奏。",
              "action": ""
            },
            {
              "actor": "ring-alpha",
              "text": "主鎖定持續。",
              "action": ""
            },
            {
              "actor": "ring-beta",
              "text": "側翼補位。",
              "action": ""
            }
          ]
        },
        {
          "label": "觀察右環",
          "lines": [
            {
              "actor": "pilot",
              "text": "右環在補位，不能只盯著前面。",
              "action": ""
            },
            {
              "actor": "ring-beta",
              "text": "側翼鎖定。",
              "action": ""
            },
            {
              "actor": "ring-alpha",
              "text": "主環同步。",
              "action": ""
            }
          ]
        }
      ]
    },
    {
      "id": "hunter",
      "title": "05 求生獵手",
      "at": 2200,
      "enemies": [
        "survival"
      ],
      "mode": "pause",
      "lines": [
        {
          "actor": "survival",
          "text": "……嘶——",
          "action": "壓低身體，目光掠過戰機，轉向後方的空隙。"
        },
        {
          "actor": "pilot",
          "text": "牠沒有一直盯著我……是在找出口。",
          "action": ""
        },
        {
          "actor": "survival",
          "text": "喀、喀……！",
          "action": "假意後退，頸部卻先轉向側面，尾巴緩慢蓄力。"
        },
        {
          "actor": "pilot",
          "text": "是假退！別追著牠的頭，注意身體和尾巴。",
          "action": ""
        },
        {
          "actor": "survival",
          "text": "嗚——吼！",
          "action": "護住受傷的軀幹，張口威嚇；喉部閃過灼熱亮光。"
        },
        {
          "actor": "pilot",
          "text": "牠在求生。先保住距離，別把自己送進牠的近身範圍。",
          "action": ""
        }
      ],
      "choices": [
        {
          "label": "留出撤離空間",
          "lines": [
            {
              "actor": "pilot",
              "text": "我往旁邊讓，先看牠會不會離開。",
              "action": ""
            },
            {
              "actor": "survival",
              "text": "……嘶。",
              "action": "抬眼確認空隙，身體仍側向戰機，沒有放鬆警戒。"
            },
            {
              "actor": "pilot",
              "text": "牠在觀察我。留路也不能背對牠。",
              "action": ""
            }
          ]
        },
        {
          "label": "警戒假退",
          "lines": [
            {
              "actor": "pilot",
              "text": "頭在退，尾巴還在蓄力。不要追。",
              "action": ""
            },
            {
              "actor": "survival",
              "text": "喀——！",
              "action": "突然扭身，以尾部遮住真正的轉向。"
            },
            {
              "actor": "pilot",
              "text": "果然是誘導。看軀幹的轉向，再決定閃避。",
              "action": ""
            }
          ]
        },
        {
          "label": "觀察熱源變化",
          "lines": [
            {
              "actor": "pilot",
              "text": "熱源在升高……先停下追擊，準備閃開嘴部方向。",
              "action": ""
            },
            {
              "actor": "survival",
              "text": "嗚……吼！",
              "action": "喉部發熱，下顎張開，熱流在口中聚集。"
            },
            {
              "actor": "pilot",
              "text": "不是平時就會噴射。牠被逼急時才準備這一招。",
              "action": ""
            }
          ]
        }
      ]
    },
    {
